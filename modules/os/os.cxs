
#If Not BRL_OS_IMPLEMENTED
#If TARGET="stdcpp" Or TARGET="glfw"
#BRL_OS_IMPLEMENTED=True
Import "native/os.cpp"
Import brl.process
Import brl.filepath
'Import brl.filesystem	' BAD FOR TRANSCC
#Endif
#Endif

#If Not BRL_OS_IMPLEMENTED
#Error "Native OS Module not implemented"
#Endif

Extern

Class BBOSModule
	Function HostOS:String()
	Function RealPath:String( path:String )
	Function FileType:Int( path:String )
	Function FileSize:Int( path:String )
	Function FileTime:Int( path:String )
	Function CopyFile:Bool( src:String,dst:String )
	Function DeleteFile:Bool( path:String )
	Function LoadString:String( path:String )
	Function SaveString:Bool( str:String,path:String )
	Function LoadDir:String[]( path:String )
	Function CreateFile:Bool( path:String )
	Function CreateDir:Bool( path:String )
	Function DeleteDir:Bool( path:String )
End

Public

Function HostOS:String()
	Return BBOSModule.HostOS
End
Function RealPath:String( path:String )
	Return BBOSModule.RealPath( path )
End

Function FileType:Int( path:String )
	Return BBOSModule.FileType( path )
End

Function FileSize:Int( path:String )
	Return BBOSModule.FileSize( path )
End

Function FileTime:Int( path:String )
	Return BBOSModule.FileTime( path )
End

Function CopyFile:Bool( src:String,dst:String )
	Return BBOSModule.CopyFile( src,dst )
End

Function DeleteFile:Bool( path:String )
	Return BBOSModule.DeleteFile( path )
End

Function LoadString:String( path:String )
	Return BBOSModule.LoadString( path )
End

Function SaveString:Bool( str:String,path:String )
	Return BBOSModule.SaveString( str,path )
End

Function LoadDir:String[]( path:String )
	Return BBOSModule.LoadDir( path )
End

Function DeleteDir:Bool( path:String )
	Return BBOSModule.DeleteDir( path )
End

Function CreateFile:Bool( path:String )
	Return BBOSModule.CreateFile( path )
End

Const FILETYPE_NONE=0
Const FILETYPE_FILE=1
Const FILETYPE_DIR=2

Function CreateDir:Bool( path:String )
    Local ret:Bool = False
    path=path.Replace("\","/")

    Local dirs:=path.Split("/")
    Local curDir:=""
	If path.StartsWith("/") Then curDir="/"
    For Local dir:=Eachin dirs
        If dir.Length()= 0 Continue
        curDir+=dir
        If FileType(curDir)<>FILETYPE_DIR
            ret=BBOSModule.CreateDir( curDir )
        Endif
        curDir+="/"
    Next
    Return ret
End

Function LoadDir:String[]( path:String,recursive:Bool,hidden:Bool=False )
	path=path.Replace("\","/")
	
	Local dirs:=New StringList,files:=New StringList
	
	dirs.AddLast ""
	
	While Not dirs.IsEmpty()

		Local dir$=dirs.RemoveFirst()

		For Local f$=Eachin LoadDir( path+"/"+dir )
			If Not hidden And f.StartsWith(".") Continue
		
			If dir f=dir+"/"+f
			
			Select FileType( path+"/"+f )
			Case FILETYPE_FILE
				files.AddLast f
			Case FILETYPE_DIR
				If recursive
					dirs.AddLast f
				Else
					files.AddLast f
				Endif
			End
		Next
	Wend

	Return files.ToArray()
End

Function CopyDir( srcpath:String,dstpath:String,recursive:Bool=True,hidden:Bool=False )
	srcpath=srcpath.Replace("\","/")
	dstpath=dstpath.Replace("\","/")
	
	If FileType( srcpath )<>FILETYPE_DIR Return False

	'do this before create of destdir to allow a dir to be copied into itself!
	'
	Local files:=LoadDir( srcpath )
	
	Select FileType( dstpath )
	Case FILETYPE_NONE
		If Not CreateDir( dstpath ) Return False
	Case FILETYPE_FILE 
		Return False
	End
	
	For Local f$=Eachin files
		If Not hidden And f.StartsWith(".") Continue
		
		Local srcp$=srcpath+"/"+f
		Local dstp$=dstpath+"/"+f
		
		Select FileType( srcp )
		Case FILETYPE_FILE
			If Not CopyFile( srcp,dstp ) Return False
		Case FILETYPE_DIR
			If recursive And Not CopyDir( srcp,dstp,recursive,hidden ) Return False
		End
	Next
	
	Return True
End

Function DeleteDir:Bool( path:String,recursive:Bool )
	path=path.Replace("\","/")
	
	If Not recursive Return BBOSModule.DeleteDir( path )
	
	Select FileType( path )
	Case FILETYPE_NONE Return True
	Case FILETYPE_FILE Return False
	End Select
	
	For Local f$=Eachin LoadDir( path )
		If f="." Or f=".." Continue

		Local fpath$=path+"/"+f

		If FileType( fpath )=FILETYPE_DIR
			If Not DeleteDir( fpath,True ) Return False
		Else
			If Not DeleteFile( fpath ) Return False
		Endif
	Next

	Return DeleteDir( path )
End
