{
    "version": 4,
    "configurePresets": [
        {
            "name": "macos-arm64-release",
            "generator": "Xcode",
            "displayName": "macOS ARM64 Release",
            "binaryDir": "${sourceDir}/demo_build/macos-arm64-release",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "macos-intel-release",
            "generator": "Xcode",
            "displayName": "macOS Intel Release",
            "binaryDir": "${sourceDir}/demo_build/macos-intel-release",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release",
                "CMAKE_OSX_ARCHITECTURES": "x86_64"
            }
        },
        {
            "name": "macos-universal-release",
            "generator": "Xcode",
            "displayName": "macOS Universal Release",
            "binaryDir": "${sourceDir}/demo_build/macos-universal-release",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
