            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "ninja-macos-universal-release",
            "generator": "Ninja",
            "displayName": "Ninja macOS Universal Release",
            "binaryDir": "${sourceDir}/demo_build/ninja-macos-universal-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64"
            }
